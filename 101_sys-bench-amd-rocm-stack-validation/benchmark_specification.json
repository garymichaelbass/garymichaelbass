  },
  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Runs seven ROCm stack probes and emits one CSV row per tool. kernel_version: expected uname -r prefix. driver_version: substring compared to amdgpu/modinfo. rocm_version: documented expectation; the collector checks package presence rather than an exact version string. required_packages: dpkg names such as rocm-core,rocm-smi. permissions_check: /dev/kfd and /dev/dri/renderD128 existence/read access. output_format: csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --kernel-version 6.8.0 --driver-version 6 --rocm-version 7.2.1 --required-packages rocm-core,rocm-smi --permissions-check true --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --kernel-version 6.8.0 --driver-version 6 --rocm-version 7.2.1 --required-packages rocm-core,rocm-smi --permissions-check true --output-format csv"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --kernel-version 6.8.0 --driver-version 6 --rocm-version 7.2.1 --required-packages rocm-core,rocm-smi --permissions-check true --output-format csv"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: ROCm package mismatch count (rocm_package_mismatch_count); #2: Kernel/driver mismatch count (kernel_driver_mismatch_count); #3: Firmware compliance percent (firmware_compliance_percent); #4: Driver compliance percent (driver_compliance_percent); #5: Permission error count (permission_error_count"
  },
  {
    "field_name": "Main Goal",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Analyze ROCm software stack consistency against yaml expectations"
  },
  {
    "field_name": "Validation Objective",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Validates ROCm tool presence, amdgpu/kernel substring match, package presence, and GPU device-node permissions. Does not run DCGM"
  },
  {
    "field_name": "Command Tools Executed",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run rvs --version, rocminfo, rocm-smi, amd-smi static, uname -a, modinfo amdgpu, hipcc --version, and dpkg-query"
  },
  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run each ROCm stack probe once (rvs, rocminfo, rocm-smi, amd-smi, uname, modinfo amdgpu, hipcc), write per-tool transcripts, and emit compliance counts per check row. yaml rocm_version is not an exact string compare"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run rvs --version, rocminfo, rocm-smi, amd-smi static, uname -a, modinfo amdgpu, hipcc --version, and dpkg-query, then compare package presence, kernel/driver substrings, and /dev/kfd plus /dev/dri/renderD128 permissions to yaml expectations, to measure ROCm stack compliance"
  },
