    "field_name": "Profile Parameter Values",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Parameters_SmokeBaselineExtend",
    "value": "{\"model_name\": {\"smoke\": \"mistralai/Mistral-7B-v0.3\", \"baseline\": \"mistralai/Mistral-7B-v0.3\", \"extended\": \"mistralai/Mistral-7B-v0.3\", \"notes\": \"\"}, \"dtype\": {\"smoke\": \"bfloat16\", \"baseline\": \"bfloat16\", \"extended\": \"bfloat16\", \"notes\": \"vLLM 0.26 rejects bf16; use bfloat16\"}, \"tensor_parallel_size\": {\"smoke\": \"1\", \"baseline\": \"1\", \"extended\": \"1\", \"notes\": \"\"}, \"gpu_memory_utilization\": {\"smoke\": \"0.9\", \"baseline\": \"0.9\", \"extended\": \"0.9\", \"notes\": \"\"}, \"prompt_source\": {\"smoke\": \"synthetic\", \"baseline\": \"synthetic\", \"extended\": \"synthetic\", \"notes\": \"\"}, \"input_len\": {\"smoke\": \"64\", \"baseline\": \"512\", \"extended\": \"1024\", \"notes\": \"\"}, \"output_len\": {\"smoke\": \"16\", \"baseline\": \"13320\", \"extended\": \"16500\", \"notes\": \"00_78: 37200 extended was 23:05. 2026-09-08: 18600 extended measured 74:43 on a throughput-collapsed run (16-wide max_num_seqs drops batching to 1-2 concurrent sequences); the healthy-batching baseline for that token count is 23:05. Extended lowered to 16500 to retarget ~12 min. Do not push back toward 37200 -- that hits the 32768 context cap and is what produced the 23-75 min runs.\"}, \"max_num_seqs\": {\"smoke\": \"2\", \"baseline\": \"8\", \"extended\": \"16\", \"notes\": \"\"}, \"max_concurrency\": {\"smoke\": \"2\", \"baseline\": \"8\", \"extended\": \"8\", \"notes\": \"\"}}"
