  {
    "field_name": "Command Methodology",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "For each yaml op_name (matmul, conv2d), dtype, and shape, execute the GPU op, compare it to a CPU FP32 reference using atol/rtol, and emit max_abs_error, max_rel_error, tolerance_compliance, coverage_count, and failure_count"
  },
  {
    "field_name": "Command Execution Details and Purpose",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Run local PyTorch GPU matmul and conv2d for each yaml op_name/dtype/shape, compare each result to a CPU FP32 reference using rtol/atol, and emit error counts, to measure tensor-op numerical correctness. Does not invoke pytest or GitHub test_ops.py"
  },
