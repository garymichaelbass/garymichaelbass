  {
    "field_name": "Execution Description With Parameters",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "Compares GPU PyTorch matmul/conv2d against a CPU FP32 reference for each yaml op/dtype/shape. op_name: matmul or conv2d. dtype and shape: sweep values. rtol/atol: comparison gates (defaults 0.02 / 0.1). num_iterations: randomized inputs per case. seed and device_id: RNG and cuda:N. This is not pytest test_ops.py"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Smoke Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --smoke --validate --device-id 0 --op-name matmul,conv2d --dtype f16_r --shape matmul=1x128x128;conv2d=1x3x32x32 --rtol 0.02 --atol 0.1 --num-iterations 2 --seed 42"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Baseline Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --baseline --validate --device-id 0 --op-name matmul,conv2d --dtype f16_r,bf16_r,f32_r --shape matmul=1x128x128,8x512x512;conv2d=1x3x32x32,8x3x64x64 --rtol f16_r=0.02,bf16_r=0.02,f32_r=1e-05 --atol f16_r=0.1,bf16_r=0.5,f32_r=1e-03 --num-iterations 50 --seed 42"
  },
  {
    "field_name": "run_benchmark Command Plus Options for Extended Run",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "bash run_benchmark.sh --extended --validate --device-id 0 --op-name matmul,conv2d --dtype f16_r,bf16_r,f32_r --shape matmul=1x128x128,8x512x512;conv2d=1x3x32x32,8x3x64x64 --rtol f16_r=0.02,bf16_r=0.02,f32_r=1e-05 --atol f16_r=0.1,bf16_r=0.5,f32_r=1e-03 --num-iterations 100 --seed 42"
  },
  {
    "field_name": "Metrics",
    "source_file": "BenchmarkSpecDefinitions.xlsx::Workload_Definitions",
    "value": "#1: Max absolute error across correctness cases (max_abs_error); #2: Max relative error across correctness cases (max_rel_error); #3: Tolerance-compliant case percentage (tolerance_compliance); #4: Test case coverage count (coverage_count); #5: Test case failure count (failure_count"
  },
